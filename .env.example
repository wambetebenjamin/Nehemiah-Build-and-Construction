# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google reCAPTCHA v3 (public site key is safe to expose; secret is server-only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional visible reCAPTCHA v2 fallback keys, required if a v3 score is below 0.5.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# Vercel KV / Upstash REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob.
BLOB_READ_WRITE_TOKEN=
# Optional public Blob URL for each current tender document (replace with a real Blob URL).
TENDER_DOCUMENT_URL=

# SMTP / Nodemailer.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
HR_EMAIL=
CONTACT_EMAIL=

# WhatsApp Cloud API. Use an approved template for business-initiated confirmations.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=project_enquiry_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
